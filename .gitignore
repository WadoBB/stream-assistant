# =============================================================
# Stream Assistant - .gitignore
# Files that must NEVER be committed to Git
# =============================================================

# --- Secret credentials (NEVER commit these) ---
ai-computer/credentials/.env
ai-computer/credentials/google_sheets.json

# --- Runtime folders (not needed in repo) ---
ai-computer/captures/
ai-computer/logs/
gaming-pc/logs/
ai-computer/overlay/state.json
ai-computer/overlay/state.json.tmp
ai-computer/overlay/car_card_state.json
ai-computer/overlay/car_card_state.json.tmp

# Car images are per-user content (not sourced from any repo-tracked asset) -
# the default_shadow.svg placeholder is tracked, but per-car photos aren't.
ai-computer/overlay/car_images/*
!ai-computer/overlay/car_images/default_shadow.svg

# car_ordinals.json itself IS tracked (see below) - only its transient
# write-in-progress temp file is excluded.
ai-computer/data/car_ordinals.json.tmp

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# --- Windows ---
Thumbs.db
Desktop.ini
